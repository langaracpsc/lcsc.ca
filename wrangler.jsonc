{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lcsc-ca",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "lcsc.ca",
      "custom_domain": true
    }
  ],
  // Any route turns wrangler's workers.dev default off, so pin both to keep today's URLs.
  "workers_dev": true,
  "preview_urls": true
}
